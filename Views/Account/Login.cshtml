@model WangenPizza.Dtos.LoginDto

@{
    Layout = null;
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Wangen</title>
    <link rel="icon" type="image/x-icon" href="~/Dashboard/images/logo.png" />

    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.3/components/logins/login-4/assets/css/login-4.css">

    <!-- Font Awesome -->

</head>

<body>
    <!-- Login 4 - Bootstrap Brain Component -->
    <section class="">

        <div class="card border-light-subtle shadow-sm">
            <div class="row g-0">
                <div class="col-12 col-md-7 d-none d-sm-block rounded-start overflow-hidden" style="height:100vh;min-height:100vh;background:linear-gradient(160deg,#1a2f45 0%,#2a5172 45%,#b8860b 100%);" aria-hidden="true"></div>
                <div class="align-items-center col-12 col-md-5 d-flex justify-content-center" style="background-color: #2a5172;height: 100vh;">
                    <div class="card-body p-3 p-md-4 p-xl-5">
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-5 text-center">
                                    <h1 style="font-weight: 700;color: white;font-size: 50px;">Hallo...</h1>
                                    <h3 style="font-weight: 600;color: white;font-size: 40px;">Benutzername und Passwort eingeben...</h3>
                                </div>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Login" method="post">
                            <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string ?? "")" />
                            @if (TempData["InvalidUserNameOrPassword"] != null)
                            {
                                <div class="alert alert-warning text-center mb-3" role="alert">Benutzername oder Passwort ist falsch.</div>
                            }
                            @if (TempData["InvalidEmail"] != null)
                            {
                                <div class="alert alert-warning text-center mb-3" role="alert">Benutzername nicht gefunden.</div>
                            }
                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="alert alert-warning text-center mb-3" role="alert">Bitte alle Felder korrekt ausfüllen.</div>
                            }
                            @if (TempData["LoginError"] is string loginErr && !string.IsNullOrWhiteSpace(loginErr))
                            {
                                <div class="alert alert-danger text-center mb-3" role="alert">@loginErr</div>
                            }
                            <div class="row gy-3 gy-md-4 overflow-hidden">
                                <div class="col-12">
                                    <input asp-for="UserName" style="font-weight: 600;font-size: 20px;" type="text" class="form-control" placeholder="Benutzer-Name" required>
                                </div>
                                <div class="col-12">
                                    <input asp-for="Password" style="font-weight: 600;font-size: 20px;" type="password" class="form-control" placeholder="Passwort" required>
                                </div>
                                <div class="col-12">
                                    <a asp-controller="Account" target="_blank" asp-action="ForgetPassword">Passwort vergessen? </a>
                                </div>
                                <div class="align-content-center d-flex justify-content-center">
                                    <div class="d-grid">
                                        <input class="btn px-5 py-2" style="background-color: #337ab7; font-weight: 600;color: white;font-size: 25px;" value="Anmelden" type="submit">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </section>
</body>
</html>

