            const pauseFrom = document.getElementById("Pausefrom");
            const pauseTill = document.getElementById("Pausetill");
            const radios = document.querySelectorAll('input[name="Pausetyp"]');

            radios.forEach(radio => {
                radio.addEventListener("change", function () {
                    if (this.value === "2") {
                        pauseFrom.removeAttribute("readonly");
                        pauseTill.removeAttribute("readonly");
                    } else {
                        pauseFrom.setAttribute("readonly", "readonly");
                        pauseTill.setAttribute("readonly", "readonly");
                    }
                });
            });
        });
    </script>

 

</body>
</html>
