    <style>
        #loading-sniper {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.8); /* Semi-transparent white background */
            z-index: 9999;
        }

        .crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-left: 2px solid black;
            border-right: 2px solid black;
            border-top: 2px solid black;
            border-bottom: 2px solid black;
            animation: sniperAnimation 2s infinite;
        }

        @@keyframes sniperAnimation {
            0% {
                width: 0;
                height: 0;
                top: 50%;
                left: 50%;
            }

            50% {
                width: 50%;
                height: 50%;
                top: 25%;
                left: 25%;
            }

            100% {
                width: 100%;
                height: 100%;
                top: 0;
                left: 0;
                opacity: 0;
            }
        }
    </style>


