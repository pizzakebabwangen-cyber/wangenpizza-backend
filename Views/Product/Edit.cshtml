@model WangenPizza.Dtos.ProductDto
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="x_panel">
    <div class="x_title">
        <h2>Menüprodukte bearbeiten </h2>

        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <br />


        <form asp-controller="Product" asp-action="Edit" class="form-horizontal form-label-left" enctype="multipart/form-data">
            <input hidden type="text" asp-for="PhotoName">

            <div class="form-group">

                <div class="col-md-12" style="display: flex;align-items: center;justify-content: center;">
                    <img src="~/Images/@Model.PhotoName" style="height:200px" />

                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                     Menüname <span class="required">*</span>
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Name" required="required" class="form-control ">
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3 ">Menüzutaten</label>
                <div class="col-md-7 col-sm-12 col-xs-12 ">
                    <textarea class="resizable_textarea form-control" asp-for="Description" placeholder="Die Zutaten, aus denen das Gericht besteht..."></textarea>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Zugehörige Unterkategorie <span class="required">*</span>
                </label>
                <div class="form-group">



                    <div class="col-md-7 col-sm-12 col-xs-12">
                        <select id="heard" asp-for="SubCategoryId" class="form-control" required="">
                            <option value="">Choose..</option>
                            @foreach (var category in ViewBag.SubCategoryList)
                            {
                                <option value="@category.Id">@category.Name</option>

                            }

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Lieferpreis  <span class="required">*</span>
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Price" required="required" class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Abholpreis <span class="required">*</span>
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Pickup_Price" required="required" class="form-control ">
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="display-order">
                    Reihenfolge im Menü (Shop)
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="number" asp-for="DisplayOrder" class="form-control" id="display-order" step="1" />
                    <p class="help-block" style="margin-top:6px">Kleinere Zahl = weiter oben in der Unterkategorie (z.&nbsp;B. Margherita = 1, nächste Pizza = 2).</p>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="last-name">
                    Menübild <span class="required">*</span>
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="file" asp-for="Photo" class="form-control ">
                </div>
            </div>
           @if(Model.AddToHome ==true)
            {
                <div class="form-group">
                    <label class="control-label col-md-3" for="last-name">
                        Zur Startseite hinzufügen?
                    </label>
                    <div class="col-md-7 col-sm-12 col-xs-12">
                        <label>
                            <input type="checkbox" asp-for="AddToHome" checked="" class="js-switch" />
                        </label>
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="control-label col-md-3" for="last-name">
                        Zur Startseite hinzufügen?
                    </label>
                    <div class="col-md-7 col-sm-12 col-xs-12">
                        <label>
                            <input type="checkbox" asp-for="AddToHome" class="js-switch" />
                        </label>
                    </div>
                </div>
            }
            <div class="form-group">
                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-danger" type="button">Abbrechen</a>
                    <input type="submit" class="btn btn-success" value="Speichern">
                </div>
            </div>
        </form>
    </div>
</div>
