@model WangenPizza.Dtos.ContactDto
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="x_panel">
    <div class="x_title">
        <h2>Details zur Kontaktanfrage </h2>

        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <br />


        <form asp-controller="Contact" asp-action="Add" class="form-horizontal form-label-left" enctype="multipart/form-data">

           

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                     Name 
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input  type="text" asp-for="Name" required="required" class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Telefon
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input  type="text" asp-for="Phone" required="required" class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Email 
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input  type="text" asp-for="Email" required="required" class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3 ">Nachricht</label>
                <div class="col-md-7 col-sm-12 col-xs-12 ">
                    <textarea class="resizable_textarea form-control" placeholder="Fügen Sie beliebige Inhalte hinzu oder lassen Sie das Feld leer" rows="18" asp-for="Message"></textarea>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                    <input type="submit" value="Speichern" class="btn btn-primary" style="padding: 5px 50px;" />
                    <a asp-controller="Contact" asp-action="Index" class="btn btn-danger" style="padding: 5px 50px;" type="button">Abbrechen</a>
                </div>
            </div>
        </form>



    </div>
</div>
