@using System.Diagnostics
@{
    Layout = null;
    var reqId = Activity.Current?.Id ?? Context.TraceIdentifier;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fehler — Wangen Pizza Admin</title>
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height: 100vh;">
    <div class="container text-center py-5">
        <h1 class="h3 mb-3">Ein Fehler ist aufgetreten</h1>
        <p class="text-muted small mb-4">Anfrage-ID: @reqId</p>
        <a class="btn btn-primary" href="/Account/Login">Zur Anmeldung</a>
    </div>
</body>
</html>
