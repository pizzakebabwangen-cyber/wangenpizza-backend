@model WangenPizza.Dtos.CompanyDataDto

@{
    ViewData["Title"] = "CreateCompanyData";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="x_panel">
    <div class="x_title">
        <h2>Unternehmensdaten erstellen </h2>

        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <br />


        <form asp-controller="Company" asp-action="CreateCompanyData" class="form-horizontal form-label-left" enctype="multipart/form-data">
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Name  <span class="required">*</span>
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Name"  class="form-control ">
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Strasse
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Street"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    PLZ
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Postbox"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Ort
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="City"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Telefon
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Phone1"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Mobile
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Phone2"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Website
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Website"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Email
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Email"  class="form-control ">
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Kontaktperson
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="ContactPrs"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    UID-Nr.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="UID"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Bankverbindung
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Bank"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    IBAN-Nr.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="IBAN"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Arbeitszeiten: Mo. - Do.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="OpenTime1"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Fr. - Sa.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="OpenTime2"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Am So.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="OpenTime3"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Lieferungszeiten: Mo. - Do.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Delivery1"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Fr. - Sa.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Delivery2"  class="form-control ">
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3" for="first-name">
                    Am So.
                </label>
                <div class="col-md-7 col-sm-12 col-xs-12">
                    <input type="text" asp-for="Delivery3"  class="form-control ">
                </div>
            </div>


            <div class="form-group">
                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                    <a asp-controller="Company" asp-action="Index" class="btn btn-danger" type="button">Abbrechen</a>
                    <!-- <button class="btn btn-primary" type="reset">Zurücksetzen</button>  -->
                    <input type="submit" class="btn btn-success" value="Speichern">
                </div>
            </div>
        </form>
    </div>
</div>