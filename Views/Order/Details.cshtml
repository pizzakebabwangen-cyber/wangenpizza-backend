@using WangenPizza.Helper
@model WangenPizza.Dtos.OrderDetailsDto
@{
    ViewData["Title"] = $"Bestellung #{Model.Id}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var wishDisplay = OrderConfirmationMailHelper.FormatOrderWishDisplay(Model.DeliveryDate, Model.DeliveryTime);
    TimeZoneInfo zurichTimeZone;
    try { zurichTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Zurich"); }
    catch { zurichTimeZone = TimeZoneInfo.FindSystemTimeZoneById("W. Europe Standard Time"); }
    var dateAddedUtc = Model.DateAdded.Kind == DateTimeKind.Utc
        ? Model.DateAdded
        : DateTime.SpecifyKind(Model.DateAdded, DateTimeKind.Utc);
    var dateAddedZurich = TimeZoneInfo.ConvertTimeFromUtc(dateAddedUtc, zurichTimeZone);
}

<div class="x_panel">
    <div class="x_title">
        <h2>Bestellung #@Model.Id</h2>
        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <div class="row" style="margin-bottom: 15px;">
            <div class="col-md-12">
                <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-warning">
                    <i class="fa fa-print"></i> Drucken (Just Eat Layout)
                </a>
                <a asp-action="Pos" class="btn btn-default">Zurück zur POS-Ansicht</a>
                <a asp-action="Index" class="btn btn-default">Alle Bestellungen</a>
            </div>
        </div>

        <table class="table table-bordered">
            <tr><th style="width: 200px;">Kunde</th><td>@Model.Name</td></tr>
            <tr><th>Adresse</th><td>@Model.Street, @Model.PostBox @Model.City</td></tr>
            <tr><th>Tel.</th><td>@Model.Phone</td></tr>
            <tr><th>E-Mail</th><td>@Model.Email</td></tr>
            <tr><th>Bestellt</th><td>@dateAddedZurich.ToString("dd.MM.yyyy HH:mm")</td></tr>
            <tr><th>Typ</th><td>@OrderConfirmationMailHelper.PickupTypeDisplay(Model.Pickup_type)</td></tr>
            <tr><th>Zahlung</th><td>@OrderConfirmationMailHelper.PaymentWayDisplay(Model.PaymentWay ?? 0)</td></tr>
            <tr><th>@OrderConfirmationMailHelper.WishTerminLabel(Model.Pickup_type)</th><td>@wishDisplay</td></tr>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <tr><th>Anmerkung</th><td>@Model.Notes</td></tr>
            }
        </table>

        <h4>Artikel</h4>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th style="width: 80px;">Anzahl</th>
                    <th style="width: 120px;">Total CHF</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items ?? new List<WangenPizza.Models.OrderItem>())
                {
                    <tr>
                        <td>
                            <strong>@(item.Product?.Name ?? "Produkt")</strong>
                            @if (item.ExtensionOrderItem != null)
                            {
                                foreach (var ext in item.ExtensionOrderItem)
                                {
                                    <div style="font-size: 12px; color: #555;">+ @ext.Name</div>
                                }
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td>@item.Subtotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2" class="text-right">Zwischensumme</th>
                    <th>CHF @((Model.TotalNumber ?? 0).ToString("0.00"))</th>
                </tr>
                @if ((Model.DiscountValue ?? 0) > 0)
                {
                    <tr>
                        <th colspan="2" class="text-right">Rabatt</th>
                        <th>-CHF @((Model.DiscountValue ?? 0).ToString("0.00"))</th>
                    </tr>
                }
                <tr>
                    <th colspan="2" class="text-right">Gesamt</th>
                    <th>CHF @((Model.FinalTotalNumber ?? 0).ToString("0.00"))</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
