@model WangenPizza.Dtos.RestaurantImageDto
@{
    ViewData["Title"] = "Restaurant Bild";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="x_panel">
    <div class="x_title">
        <h2>Restaurant-Bild hinzufügen</h2>
        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <form asp-action="Create" enctype="multipart/form-data" class="form-horizontal form-label-left">
            <div class="form-group">
                <label class="control-label col-md-3">Bild <span class="required">*</span></label>
                <div class="col-md-7">
                    <input type="file" asp-for="Photo" required class="form-control" accept="image/*" />
                    <span class="help-block">z. B. Fassade mit Ofen und Pizza</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3">Beschriftung</label>
                <div class="col-md-7">
                    <input type="text" asp-for="Caption" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3">Reihenfolge</label>
                <div class="col-md-7">
                    <input type="number" asp-for="SortOrder" class="form-control" value="0" min="0" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-3">Hauptbild (Hero)</label>
                <div class="col-md-7">
                    <input type="checkbox" asp-for="IsHero" />
                    <span class="help-block">Wird gross oben auf der Restaurant-Seite angezeigt.</span>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-6 col-md-offset-3">
                    <a asp-action="Index" class="btn btn-danger">Abbrechen</a>
                    <input type="submit" class="btn btn-success" value="Speichern" />
                </div>
            </div>
        </form>
    </div>
</div>
