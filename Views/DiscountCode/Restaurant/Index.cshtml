@model IEnumerable<WangenPizza.Dtos.RestaurantImageDto>
@{
    ViewData["Title"] = "Restaurant";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var settings = ViewBag.Settings as WangenPizza.Dtos.RestaurantSettingsDto;
}

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title" style="display: flex;justify-content: space-between;flex-wrap: wrap;gap: 10px;">
                <div>
                    <a asp-action="Create" class="btn btn-info"><i class="fa fa-plus"></i> Bild hinzufügen</a>
                    <a asp-action="Settings" class="btn btn-default"><i class="fa fa-cog"></i> Seitentext & Video</a>
                </div>
                <div>
                    <h2 style="overflow:initial;font-weight: 800;font-size: 20px;">Restaurant / Galerie</h2>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                @if (settings != null)
                {
                    <p><strong>@settings.Title</strong></p>
                    @if (!string.IsNullOrWhiteSpace(settings.VideoUrl))
                    {
                        <p>Video: @settings.VideoUrl</p>
                    }
                }
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Reihenfolge</th>
                            <th>Hauptbild</th>
                            <th>Bild</th>
                            <th>Beschriftung</th>
                            <th>Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SortOrder</td>
                                <td>@(item.IsHero ? "Ja" : "Nein")</td>
                                <td><img src="~/Images/@item.PhotoName" style="height:80px;max-width:140px;object-fit:cover;" alt="" /></td>
                                <td>@item.Caption</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm"><i class="fa fa-pencil"></i> Bearbeiten</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bild löschen?');"><i class="fa fa-trash"></i> Löschen</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
