<?xml version="1.0" encoding="utf-8"?>
<!-- Stand: 2026-04-05 — requestTimeout für SignalR SSE/Long Polling (offene Requests) -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Long Polling hält HTTP Requests offen; Default-Timeout zu kurz → disconnect / kein Push -->
      <aspNetCore processPath="dotnet" arguments=".\WangenPizza.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" requestTimeout="00:20:00" />
    </system.webServer>
  </location>
</configuration>