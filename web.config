<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: Site-spezifische URL-Rewrite-Regeln hier im Repo pflegen und mit deployen, nicht nur auf dem Server lassen. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WangenPizza.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" requestTimeout="00:20:00" />
    </system.webServer>
  </location>
</configuration>